{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["TELEGRAM_BOT_TOKEN", "DISCORD_BOT_TOKEN", "NODE_ENV", "DISCORD_OWNER_IDS", "MEGA_EMAIL", "MEGA_PASSWORD", "MEGA_FOLDER"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:deploy": {
      "cache": false
    }
  }
}
